{
  "name": "calendar-copilot",
  "version": "0.1.0",
  "private": true,
  "description": "A privacy-conscious personal Google Calendar agent.",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:offline": "npm run check && npm test",
    "format": "prettier --write ."
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "googleapis": "^144.0.0",
    "openai": "^4.104.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.30",
    "prettier": "^3.5.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}

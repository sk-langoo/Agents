# Obtain these from Google Cloud Console. Never commit the real values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2/callback

# Required only for natural-language chat at POST /chat.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

PORT=3000
CALENDAR_TIME_ZONE=America/New_York
